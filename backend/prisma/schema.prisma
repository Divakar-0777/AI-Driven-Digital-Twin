datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   String                 @id @default(uuid())
  email                String                 @unique
  password             String
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  profile              Profile?
  transactions         FinancialTransaction[]
  studySessions        StudySession[]
  habits               Habit[]
  activityHistory      ActivityHistory[]
  digitalTwinState     DigitalTwinState?
  aiRecommendations    AiRecommendation[]
  notifications        Notification[]
  predictionHistory    PredictionHistory[]
  analyticsSummary     AnalyticsSummary?
  budgets              Budget[]
  financialGoals       FinancialGoal[]
  goals                Goal[]
  financialSimulations FinancialSimulation[]
  decisionSimulations  DecisionSimulation[]
  chatConversations    ChatConversation[]

  @@map("Users")
}

model Profile {
  id                   String   @id @default(uuid())
  userId               String   @unique
  fullName             String
  phoneNumber          String?
  dateOfBirth          DateTime?
  occupation           String?
  educationLevel       String?
  gender               String?
  monthlyIncome        Decimal  @default(0.00)
  monthlyExpenseTarget Decimal  @default(0.00)
  savings              Decimal  @default(0.00)
  financialGoals       String?
  studyGoal            String?
  dailyStudyHoursTarget Float   @default(0.0)
  fitnessGoal          String?
  lifestyleInfo        String?
  longTermGoals        String?
  habitGoals           String?
  profilePhotoUrl      String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("Profiles")
}

model FinancialTransaction {
  id                  String   @id @default(uuid())
  userId              String
  title               String
  category            String
  type                String   // 'INCOME' or 'EXPENSE'
  amount              Decimal
  date                DateTime @default(now())
  paymentMethod       String
  notes               String?
  recurring           Boolean  @default(false)
  recurrenceFrequency String?  // 'DAILY', 'WEEKLY', 'MONTHLY', 'YEARLY'

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
  @@index([userId, type])
  @@index([userId, category])
  @@map("FinancialTransactions")
}

model StudySession {
  id                 String   @id @default(uuid())
  userId             String
  subject            String
  topic              String
  duration           Int      // Duration in minutes
  date               DateTime @default(now())
  productivityRating Int      // 1-5 rating
  notes              String?

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
  @@index([userId, subject])
  @@map("StudySessions")
}

model Habit {
  id              String   @id @default(uuid())
  userId          String
  name            String
  targetFrequency String
  completed       Boolean  @default(false)
  date            DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
  @@index([userId, name])
  @@map("Habits")
}

model DigitalTwinState {
  id                   String   @id @default(uuid())
  userId               String   @unique
  productivityScore    Float    @default(0.0)
  financialHealthScore Float    @default(0.0)
  habitScore           Float    @default(0.0)
  studyScore           Float    @default(0.0)
  goalScore            Float    @default(0.0)
  overallScore         Float    @default(0.0)
  twinEmoticon         String   @default("😐")
  twinStatus           String   @default("Initializing")
  personalitySummary   String?
  behaviourSummary     String?
  syncTimestamp        DateTime @default(now())

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("DigitalTwinStates")
}

model AiRecommendation {
  id                 String   @id @default(uuid())
  userId             String
  category           String   // 'FINANCE', 'STUDY', 'HABITS', 'GOALS'
  recommendationText String
  reason             String?
  expectedImpact     String?
  risk               String?
  suggestedAction    String?
  impactLevel        String   // 'HIGH', 'MEDIUM', 'LOW'
  isApplied          Boolean  @default(false)
  createdAt          DateTime @default(now())

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("AiRecommendations")
}

model ActivityHistory {
  id           String   @id @default(uuid())
  userId       String
  activityType String
  description  String
  timestamp    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, timestamp])
  @@map("ActivityHistory")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   // 'INFO', 'ALERT', 'ACHIEVEMENT'
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("Notifications")
}

model PredictionHistory {
  id               String   @id @default(uuid())
  userId           String
  predictionType   String   // 'FINANCE', 'STUDY', 'HABITS'
  predictionResult Json     // Stores predictions and parameters
  confidenceScore  Float    // Score between 0 and 1
  createdAt        DateTime @default(now())

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("PredictionHistories")
}

model AnalyticsSummary {
  id                   String   @id @default(uuid())
  userId               String   @unique
  financialHealthScore Float    @default(0.0)
  productivityScore    Float    @default(0.0)
  habitScore           Float    @default(0.0)
  studyScore           Float    @default(0.0)
  goalScore            Float    @default(0.0)
  overallAIScore       Float    @default(0.0)
  updatedAt            DateTime @updatedAt

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("AnalyticsSummaries")
}

model Budget {
  id              String   @id @default(uuid())
  userId          String
  category        String
  monthlyLimit    Decimal
  currentSpending Decimal  @default(0.00)
  period          String   @default("MONTHLY") // 'MONTHLY', 'WEEKLY'
  status          String   @default("ACTIVE")  // 'ACTIVE', 'INACTIVE'
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("Budgets")
}

model FinancialGoal {
  id                  String   @id @default(uuid())
  userId              String
  goalName            String
  targetAmount        Decimal
  currentAmount       Decimal  @default(0.00)
  monthlyContribution Decimal  @default(0.00)
  targetDate          DateTime
  priority            String   @default("MEDIUM") // 'HIGH', 'MEDIUM', 'LOW'
  goalCategory        String   // 'EMERGENCY_FUND', 'LAPTOP', 'EDUCATION', 'TRAVEL', etc.
  status              String   @default("ACTIVE") // 'ACTIVE', 'ACHIEVED', 'FAILED'
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("FinancialGoals")
}

model Goal {
  id              String   @id @default(uuid())
  userId          String
  goalName        String
  description     String?
  goalType        String   // 'FINANCIAL', 'ACADEMIC', 'FITNESS', 'CAREER', 'PERSONAL', 'LIFESTYLE'
  targetValue     Float
  currentValue    Float    @default(0.0)
  unit            String?  // 'dollars', 'hours', 'kg', 'count', etc.
  deadline        DateTime?
  priority        String   @default("MEDIUM") // 'HIGH', 'MEDIUM', 'LOW'
  status          String   @default("ACTIVE") // 'ACTIVE', 'COMPLETED', 'FAILED', 'PAUSED'
  progressPercent Float    @default(0.0)
  riskLevel       String?  // 'LOW', 'MEDIUM', 'HIGH'
  aiRecommendation String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, goalType])
  @@map("Goals")
}

model FinancialSimulation {
  id                String   @id @default(uuid())
  userId            String
  scenarioName      String
  assumptions       String   // JSON string containing scenario parameters
  projectedIncome   Decimal
  projectedExpenses Decimal
  projectedSavings  Decimal
  projectedBalance  Decimal
  goalImpact        String?
  riskLevel         String   @default("LOW") // 'LOW', 'MODERATE', 'HIGH'
  createdAt         DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("FinancialSimulations")
}

model DecisionSimulation {
  id             String   @id @default(uuid())
  userId         String
  decision       String   // JSON string representing decision inputs
  baseline       String   // JSON string representing the "Current Path" outcome
  scenarios      String   // JSON string of generated alternative scenarios
  assumptions    String   // JSON string of explicit transparency rules/assumptions
  outcomes       String   // JSON string of projected future states per domain
  comparison     String   // JSON string of normalized side-by-side comparisons
  recommendation String   // JSON string of final recommendations, trade-offs, and ranking
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("DecisionSimulations")
}

model ChatConversation {
  id        String        @id @default(uuid())
  userId    String
  title     String        @default("New Conversation")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([userId])
  @@map("ChatConversations")
}

model ChatMessage {
  id             String   @id @default(uuid())
  conversationId String
  role           String   // 'user' or 'assistant'
  content        String
  mode           String?  // 'LLM', 'Deterministic', etc.
  createdAt      DateTime @default(now())

  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ChatMessages")
}
