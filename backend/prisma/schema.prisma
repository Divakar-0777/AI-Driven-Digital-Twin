datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   String                 @id @default(uuid())
  email                String                 @unique
  password             String
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  profile              Profile?
  transactions         FinancialTransaction[]
  studySessions        StudySession[]
  habits               Habit[]
  activityHistory      ActivityHistory[]
  digitalTwinState     DigitalTwinState?
  aiRecommendations    AiRecommendation[]
  notifications        Notification[]

  @@map("Users")
}

model Profile {
  id                   String   @id @default(uuid())
  userId               String   @unique
  fullName             String
  phoneNumber          String?
  dateOfBirth          DateTime?
  occupation           String?
  educationLevel       String?
  monthlyIncome        Decimal  @default(0.00)
  monthlyExpenseTarget Decimal  @default(0.00)
  studyGoal            String?
  dailyStudyHoursTarget Float   @default(0.0)
  habitGoals           String?
  profilePhotoUrl      String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("Profiles")
}

model FinancialTransaction {
  id            String   @id @default(uuid())
  userId        String
  title         String
  category      String
  type          String   // 'INCOME' or 'EXPENSE'
  amount        Decimal
  date          DateTime @default(now())
  paymentMethod String
  notes         String?

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
  @@map("FinancialTransactions")
}

model StudySession {
  id                 String   @id @default(uuid())
  userId             String
  subject            String
  topic              String
  duration           Int      // Duration in minutes
  date               DateTime @default(now())
  productivityRating Int      // 1-5 rating
  notes              String?

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("StudySessions")
}

model Habit {
  id              String   @id @default(uuid())
  userId          String
  name            String
  targetFrequency String
  completed       Boolean  @default(false)
  date            DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("Habits")
}

model DigitalTwinState {
  id                   String   @id @default(uuid())
  userId               String   @unique
  productivityScore    Float    @default(0.0)
  financialHealthScore Float    @default(0.0)
  twinEmoticon         String   @default("😐")
  twinStatus           String   @default("Initializing")
  syncTimestamp        DateTime @default(now())

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("DigitalTwinStates")
}

model AiRecommendation {
  id                 String   @id @default(uuid())
  userId             String
  category           String   // 'FINANCE', 'STUDY', 'HABITS'
  recommendationText String
  impactLevel        String   // 'HIGH', 'MEDIUM', 'LOW'
  isApplied          Boolean  @default(false)
  createdAt          DateTime @default(now())

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("AiRecommendations")
}

model ActivityHistory {
  id           String   @id @default(uuid())
  userId       String
  activityType String
  description  String
  timestamp    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("ActivityHistory")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   // 'INFO', 'ALERT', 'ACHIEVEMENT'
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("Notifications")
}
